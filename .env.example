# ---- Base data -----------------------------------------------------------
# Root directory for the MVTec AD dataset (auto-created by the download script).
DEFECTBENCH_DATA_DIR=C:/AI/vlm-defect-benchmark/data

# Comma-separated MVTec categories to use (device-like domains).
DEFECTBENCH_CATEGORIES=bottle,screw,cable,metal_nut,transistor,capsule

# Where baseline model and eval manifests are stored.
DEFECTBENCH_ARTIFACTS_DIR=C:/AI/vlm-defect-benchmark/artifacts

# ---- Ollama (layer 2: VLM) ------------------------------------------------
OLLAMA_HOST=http://localhost:11434
DEFECTBENCH_VLM_MODEL=qwen2.5vl:3b
# Seconds to wait for a single VLM response (CPU inference is slow).
DEFECTBENCH_VLM_TIMEOUT=180

